<div class="admin-container">
    <div class="profile-header">
        <div class="profile-avatar">
            <% if (profileUser.thumbnailUrl || profileUser.profilePictureUrl) { %>
                <img src="<%= profileUser.thumbnailUrl || profileUser.profilePictureUrl %>"
                    alt="<%= profileUser.name %>">
                <% } else { %>
                    <div class="avatar-initials large">
                        <%= profileUser.name.substring(0,2).toUpperCase() %>
                    </div>
                    <% } %>
        </div>
        <div class="profile-info">
            <h1>
                <%= profileUser.name %>
                    <% if (profileUser.isVerified) { %>
                        <span class="verified-badge" title="Verified User">✓</span>
                        <% } %>
            </h1>
            <p>
                <%= profileUser.email %>
            </p>
            <p>
                <%= profileUser.bio || 'No bio' %>
            </p>
            <% if (profileUser.isDeleted) { %>
                <span class="status-badge status-inactive">Deleted</span>
                <% } %>
                    <% if (profileUser.id===user.id) { %>
                        <div class="user-actions">
                            <a href="/profile/edit" class="btn-admin btn-promote">Edit Profile</a>
                            <a href="/change-password" class="btn-admin btn-activate">Change Password</a>
                        </div>
                        <% } else { %>
                            <div class="user-actions">
                                <% if (profileUser.isDeleted) { %>
                                    <button type="button" class="btn-admin btn-deactivate" disabled>Deleted</button>
                                    <button type="button" class="btn-admin btn-promote" disabled>Promote to
                                        Admin</button>
                                    <button type="button" class="btn-admin btn-delete" disabled>Delete User</button>
                                    <% } else if (profileUser.role !=='admin' ) { %>
                                        <form method="POST"
                                            action="/admin/user/<%= profileUser.id %>/<%= profileUser.isActive ? 'deactivate' : 'activate' %>"
                                            class="inline-action-form">
                                            <button type="submit"
                                                class="btn-admin <%= profileUser.isActive ? 'btn-deactivate' : 'btn-activate' %>">
                                                <%= profileUser.isActive ? 'Deactivate' : 'Activate' %>
                                            </button>
                                        </form>
                                        <form method="POST" action="/admin/user/<%= profileUser.id %>/promote"
                                            class="inline-action-form">
                                            <button type="submit" class="btn-admin btn-promote">Promote to
                                                Admin</button>
                                        </form>
                                        <form method="POST" action="/admin/user/<%= profileUser.id %>/delete"
                                            onsubmit="return confirm('Delete this user permanently?')"
                                            class="inline-action-form">
                                            <button type="submit" class="btn-admin btn-delete">Delete User</button>
                                        </form>
                                        <% } %>
                            </div>
                            <% } %>
        </div>
    </div>

    <% if (profileUser.id !==user.id) { %>
        <h2>User's Posts</h2>
        <div class="posts-grid">
            <% posts.forEach(post=> { %>
                <div class="post-card" data-href="/admin/post/<%= post.id %>">
                    <a href="/admin/post/<%= post.id %>" class="admin-card-link"
                        aria-label="View admin post details"></a>
                    <div class="post-header">
                        <div class="post-author">
                            <div class="post-author-avatar">
                                <% if (post.User?.thumbnailUrl || post.User?.profilePictureUrl) { %>
                                    <img src="<%= post.User.thumbnailUrl || post.User.profilePictureUrl %>"
                                        alt="<%= post.User.name %>">
                                    <% } else { %>
                                        <div class="avatar-initials small">
                                            <%= (post.User?.name || 'U' ).substring(0,2).toUpperCase() %>
                                        </div>
                                        <% } %>
                            </div>
                            <div class="post-author-info">
                                <strong>
                                    <%= post.User?.name || 'Unknown' %>
                                </strong>
                                <small>
                                    <%= new Date(post.createdAt).toLocaleString() %>
                                </small>
                            </div>
                        </div>
                    </div>
                    <div class="post-content">
                        <p>
                            <%= post.content.substring(0, 150) %>
                                <%= post.content.length> 150 ? '...' : '' %>
                        </p>
                        <% if (post.imageUrl) { %>
                            <img src="<%= post.thumbnailUrl || post.imageUrl %>" class="post-thumb" alt="image">
                            <% } %>
                    </div>
                    <div class="post-stats">
                        <span><i class="fa-regular fa-heart"></i>
                            <%= post.likeCount || 0 %> likes
                        </span>
                        <span><i class="fa-regular fa-comment"></i>
                            <%= post.commentCount || 0 %> comments
                        </span>
                        <% if (post.isDeleted) { %>
                            <span class="status-badge status-inactive">Deleted</span>
                            <% } %>
                    </div>
                    <div class="post-actions">
                        <% if (post.isDeleted) { %>
                            <button type="button" class="btn-admin btn-delete" disabled>Already deleted</button>
                            <% } else { %>
                                <form method="POST" action="/admin/post/<%= post.id %>/delete"
                                    onsubmit="return confirm('Delete this post? All comments will be deleted.')">
                                    <button type="submit" class="btn-admin btn-delete"><i
                                            class="fa-regular fa-trash-can"></i>
                                        Delete Post</button>
                                </form>
                                <% } %>
                    </div>
                </div>
                <% }) %>
                    <% if (posts.length===0) { %>
                        <div class="empty-state">No posts from this user.</div>
                        <% } %>
        </div>
        <% } %>
</div>