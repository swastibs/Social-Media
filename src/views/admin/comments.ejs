<div class="admin-container">
    <div class="admin-header">
        <h1>Manage Comments</h1>
        <p>View and manage all user comments</p>
    </div>

    <div class="admin-filters">
        <form method="GET" class="filter-form">
            <div class="filter-group">
                <label for="commentSearch"><i class="fa-solid fa-magnifying-glass"></i> Search Comments</label>
                <input id="commentSearch" type="text" name="search" placeholder="Search comments by content..."
                    value="<%= searchQuery %>" class="filter-input">
            </div>
            <details class="filter-group filter-group-full">
                <summary><i class="fa-solid fa-sliders"></i> Filters</summary>
                <div class="filter-row">
                    <div class="filter-group">
                        <label for="commentCreatedFrom"><i class="fa-regular fa-calendar"></i> Created From</label>
                        <input id="commentCreatedFrom" type="date" name="createdFrom" value="<%= filters.createdFrom %>"
                            class="filter-input">
                    </div>
                    <div class="filter-group">
                        <label for="commentCreatedTo"><i class="fa-regular fa-calendar"></i> Created To</label>
                        <input id="commentCreatedTo" type="date" name="createdTo" value="<%= filters.createdTo %>"
                            class="filter-input">
                    </div>
                    <div class="filter-group">
                        <label for="commentDeleted"><i class="fa-solid fa-trash"></i> Deleted</label>
                        <select id="commentDeleted" name="deleted" class="filter-select">
                            <option value="all" <%=filters.deleted==='all' ? 'selected' : '' %>>All</option>
                            <option value="active" <%=filters.deleted==='active' ? 'selected' : '' %>>Only active
                            </option>
                            <option value="deleted" <%=filters.deleted==='deleted' ? 'selected' : '' %>>Only deleted
                            </option>
                        </select>
                    </div>
                    <div class="filter-group">
                        <label for="commentSortBy"><i class="fa-solid fa-arrow-down-wide-short"></i> Sort By</label>
                        <select id="commentSortBy" name="sortBy" class="filter-select">
                            <option value="createdAt" <%=filters.sortBy==='createdAt' ? 'selected' : '' %>>Created
                            </option>
                            <option value="postId" <%=filters.sortBy==='postId' ? 'selected' : '' %>>Post ID</option>
                        </select>
                    </div>
                </div>
                <div class="filter-row">
                    <div class="filter-group">
                        <label for="commentOrder"><i class="fa-solid fa-arrow-up-a-z"></i> Order</label>
                        <select id="commentOrder" name="order" class="filter-select">
                            <option value="DESC" <%=filters.order==='DESC' ? 'selected' : '' %>>DESC</option>
                            <option value="ASC" <%=filters.order==='ASC' ? 'selected' : '' %>>ASC</option>
                        </select>
                    </div>
                </div>
            </details>
            <div class="filter-actions">
                <button type="submit" class="btn-primary"><i class="fa-solid fa-search"></i> Search</button>
                <% if (searchQuery || filters.createdFrom || filters.createdTo || filters.deleted !=='all' ||
                    filters.sortBy !=='createdAt' || filters.order !=='DESC' ) { %>
                    <a href="/admin/comments" class="btn-secondary"><i class="fa-solid fa-times"></i> Clear</a>
                    <% } %>
            </div>
        </form>
    </div>

    <div class="admin-grid">
        <% if (comments.length===0) { %>
            <div class="empty-state admin-grid-empty">
                <i class="fa-regular fa-comment-dots empty-icon"></i>
                <p>No comments found</p>
            </div>
            <% } else { %>
                <% comments.forEach(comment=> { %>
                    <div class="admin-card" data-href="/admin/post/<%= comment.postId %>">
                        <a href="/admin/post/<%= comment.postId %>" class="admin-card-link"
                            aria-label="View related admin post"></a>
                        <div class="card-content">
                            <div class="card-header-row">
                                <div class="avatar-sm">
                                    <% if (comment.User.thumbnailUrl || comment.User.profilePictureUrl) { %>
                                        <img src="<%= comment.User.thumbnailUrl || comment.User.profilePictureUrl %>"
                                            alt="<%= comment.User.name %>" class="avatar-sm">
                                        <% } else { %>
                                            <div class="avatar-initials small">
                                                <%= comment.User.name.substring(0,2).toUpperCase() %>
                                            </div>
                                            <% } %>
                                </div>
                                <div>
                                    <div class="card-title-text">
                                        <%= comment.User.name %>
                                            <% if (comment.User.isVerified) { %>
                                                <span class="verified-badge-small" title="Verified User">✓</span>
                                                <% } %>
                                    </div>
                                    <div class="card-subtitle">
                                        <%= new Date(comment.createdAt).toLocaleString() %>
                                    </div>
                                    <% if (comment.isDeleted) { %>
                                        <span class="status-badge status-inactive">Deleted</span>
                                        <% } %>
                                </div>
                            </div>
                            <div class="card-body">
                                <p>“<%= comment.content.substring(0, 120) %>
                                        <%= comment.content.length> 120 ? '...' : '' %>”</p>
                                <div class="card-subtitle">on post: <%= comment.Post ? comment.Post.content.substring(0,
                                        80) : 'Post deleted' %>
                                        <%= comment.Post && comment.Post.content.length> 80 ? '...' : '' %></div>
                            </div>
                            <div class="card-actions" onclick="event.stopPropagation();">
                                <a href="/admin/post/<%= comment.postId %>" class="action-btn info" title="View Post"><i
                                        class="fa-solid fa-eye"></i></a>
                                <% if (comment.isDeleted) { %>
                                    <button type="button" class="action-btn danger" title="Already deleted" disabled><i
                                            class="fa-solid fa-trash"></i></button>
                                    <span class="card-subtitle">Already deleted</span>
                                    <% } else { %>
                                        <form method="POST" action="/admin/comment/<%= comment.id %>/delete"
                                            class="inline-action-form" data-admin-confirm="delete-comment">
                                            <button type="submit" class="action-btn danger" title="Delete Comment"><i
                                                    class="fa-solid fa-trash"></i></button>
                                        </form>
                                        <% } %>
                            </div>
                        </div>
                    </div>
                    <% }) %>
                        <% } %>
    </div>

    <%- include('../partials/pagination', { pagination, baseUrl: '/admin/comments' , query: { search: searchQuery,
        createdFrom: filters.createdFrom, createdTo: filters.createdTo, deleted: filters.deleted, sortBy:
        filters.sortBy, order: filters.order } }) %>
</div>

<script>
    document.querySelectorAll('.admin-card').forEach(card => {
        card.addEventListener('click', (e) => {
            if (e.target.closest('.card-actions')) return;
            const href = card.dataset.href;
            if (href) window.location.href = href;
        });
    });
</script>