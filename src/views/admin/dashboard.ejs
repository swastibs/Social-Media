<div class="admin-container">
    <div class="admin-header">
        <h1>Admin Dashboard</h1>
        <p>Welcome back, <strong>
                <%= user.name %>
            </strong>! Here's what's happening on PostLoop.</p>
    </div>

    <div class="stats-grid">
        <a href="/admin/users" class="stat-card">
            <div class="stat-icon users-icon"><i class="fa-solid fa-users"></i></div>
            <div class="stat-info">
                <h3>
                    <%= stats.totalUsers.toLocaleDateString('en-GB') %>
                </h3>
                <p>Total Users</p>
                <span class="stat-link">Manage <i class="fa-solid fa-arrow-right"></i></span>
            </div>
        </a>
        <a href="/admin/posts" class="stat-card">
            <div class="stat-icon posts-icon"><i class="fa-solid fa-newspaper"></i></div>
            <div class="stat-info">
                <h3>
                    <%= stats.totalPosts.toLocaleDateString('en-GB') %>
                </h3>
                <p>Total Posts</p>
                <span class="stat-link">Manage <i class="fa-solid fa-arrow-right"></i></span>
            </div>
        </a>
        <a href="/admin/comments" class="stat-card">
            <div class="stat-icon comments-icon"><i class="fa-solid fa-comments"></i></div>
            <div class="stat-info">
                <h3>
                    <%= stats.totalComments.toLocaleDateString('en-GB') %>
                </h3>
                <p>Total Comments</p>
                <span class="stat-link">Manage <i class="fa-solid fa-arrow-right"></i></span>
            </div>
        </a>
    </div>

    <div class="dashboard-grid">
        <div class="dashboard-card">
            <div class="card-header">
                <h2>Latest Users</h2>
                <a href="/admin/users" class="view-all-link">View All <i class="fa-solid fa-chevron-right"></i></a>
            </div>
            <div class="card-body">
                <% latestUsers.forEach(user=> { %>
                    <div class="list-item">
                        <div class="item-avatar">
                            <% if (user.profilePictureUrl) { %>
                                <img src="<%= user.profilePictureUrl %>">
                                <% } else { %>
                                    <div class="avatar-initials">
                                        <%= user.name.substring(0,2).toUpperCase() %>
                                    </div>
                                    <% } %>
                        </div>
                        <div class="item-info">
                            <div class="item-name">
                                <%= user.name %>
                            </div>
                            <div class="item-email">
                                <%= user.email %>
                            </div>
                            <div class="item-date">
                                <%= new Date(user.createdAt).toLocaleDateString() %>
                            </div>
                        </div>
                    </div>
                    <% }) %>
            </div>
        </div>
        <div class="dashboard-card">
            <div class="card-header">
                <h2>Latest Posts</h2>
                <a href="/admin/posts" class="view-all-link">View All <i class="fa-solid fa-chevron-right"></i></a>
            </div>
            <div class="card-body">
                <% latestPosts.forEach(post=> { %>
                    <div class="list-item">
                        <div class="item-avatar">
                            <% if (post.User?.profilePictureUrl) { %>
                                <img src="<%= post.User.profilePictureUrl %>">
                                <% } else { %>
                                    <div class="avatar-initials">
                                        <%= post.User?.name?.substring(0,2).toUpperCase() || 'U' %>
                                    </div>
                                    <% } %>
                        </div>
                        <div class="item-info">
                            <div class="item-name">
                                <%= post.User?.name || 'Unknown' %>
                            </div>
                            <div class="item-preview">
                                <%= post.content.substring(0,80) %>
                                    <%= post.content.length> 80 ? '...' : '' %>
                            </div>
                        </div>
                    </div>
                    <% }) %>
            </div>
        </div>
    </div>
</div>