<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %>
    </title>
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>
    <div style="max-width:600px; margin:5rem auto; text-align:center;">
        <div style="background:var(--error-color); color:white; padding:1rem; border-radius:12px;">
            <h4>
                <%= title %>
            </h4>
            <p>
                <%= message %>
            </p>
            <a href="javascript:history.back()" style="color:white; text-decoration:underline;">Go Back</a>
        </div>
    </div>
</body>

</html>