<div class="error-container" style="max-width:600px; margin:5rem auto; text-align:center;">
    <div style="background:var(--error-color); color:white; padding:2rem; border-radius:16px;">
        <i class="fa-solid fa-circle-exclamation" style="font-size:3rem; margin-bottom:1rem; display:block;"></i>
        <h1>
            <%= title %>
        </h1>
        <p>
            <%= message %>
        </p>
        <a href="javascript:history.back()" class="btn-primary" style="display:inline-block; margin-top:1rem;">
            Go Back
        </a>
    </div>
</div>