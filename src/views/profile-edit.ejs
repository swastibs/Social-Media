<div class="profile-edit-container">
    <div class="profile-edit-header">
        <h1>Edit Profile</h1>
        <p>Update your personal information</p>
    </div>

    <form action="/profile/edit" method="POST" enctype="multipart/form-data" class="profile-edit-form">
        <!-- Name -->
        <div class="form-group">
            <label for="name">Username</label>
            <input type="text" id="name" name="name" value="<%= user.name %>" required class="form-input">
        </div>

        <!-- Bio -->
        <div class="form-group">
            <label for="bio">Bio</label>
            <textarea id="bio" name="bio" rows="4" class="form-textarea"><%= user.bio || '' %></textarea>
        </div>

        <!-- Profile Picture Section -->
        <div class="form-group">
            <label>Profile Picture</label>
            <div class="profile-picture-section">
                <div class="current-profile-picture">
                    <% if (user.thumbnailUrl || user.profilePictureUrl) { %>
                        <img src="<%= user.thumbnailUrl || user.profilePictureUrl %>" alt="<%= user.name %>"
                            id="profilePreview" class="img-cover" width="100" height="100"
                            style="width:100px; height:100px;">
                        <% } else { %>
                            <div class="avatar-initials large" id="profilePreview">
                                <%= user.name.substring(0,2).toUpperCase() %>
                            </div>
                            <% } %>
                </div>
                <div class="profile-picture-actions">
                    <label for="profilePicture" class="btn-secondary">Change Photo</label>
                    <input type="file" id="profilePicture" name="profilePicture" accept="image/*"
                        style="display: none;">
                    <% if (user.profilePictureUrl) { %>
                        <label class="checkbox-label">
                            <input type="checkbox" name="removeImage" value="true"> Remove current photo
                        </label>
                        <% } %>
                </div>
            </div>
        </div>

        <!-- Privacy Toggle (public/private) -->
        <div class="form-group">
            <label class="checkbox-label">
                <input type="checkbox" name="isPrivate" value="true" <%=user.isPrivate ? 'checked' : '' %>>
                <i class="fa-solid fa-lock"></i> Make my account private
            </label>
            <small class="form-text text-muted">Only approved followers can see your posts and follow you.</small>
        </div>

        <!-- Form Actions -->
        <div class="form-actions">
            <a href="/profile/<%= user.id %>" class="btn-secondary">Cancel</a>
            <button type="submit" class="btn-primary">Save Changes</button>
        </div>
    </form>
</div>

<script>
    const profilePictureInput = document.getElementById('profilePicture');
    const profilePreview = document.getElementById('profilePreview');

    function handleFileChange(e) {
        const file = e.target.files[0];
        if (file) {
            const reader = new FileReader();
            reader.onload = function (event) {
                if (profilePreview.tagName === 'IMG') {
                    profilePreview.src = event.target.result;
                } else {
                    const img = document.createElement('img');
                    img.id = 'profilePreview';
                    img.src = event.target.result;
                    img.style.width = '100%';
                    img.style.height = '100%';
                    img.style.objectFit = 'cover';
                    profilePreview.parentNode.replaceChild(img, profilePreview);
                }
            };
            reader.readAsDataURL(file);
        }
    }

    if (profilePictureInput) {
        profilePictureInput.addEventListener('change', handleFileChange);
    }

    function cleanupProfileEdit() {
        if (profilePictureInput) {
            profilePictureInput.removeEventListener('change', handleFileChange);
        }
        window.profilePictureInputRef = null;
        window.profilePreviewRef = null;
    }
    window.cleanupProfileEdit = cleanupProfileEdit;
</script>