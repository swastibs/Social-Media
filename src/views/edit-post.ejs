<div class="post-form-container">
    <div class="form-header">
        <h1>Edit Post</h1>
        <p>Update your thoughts</p>
    </div>

    <form action="/post/edit/<%= post.id %>" method="POST" enctype="multipart/form-data" class="post-form"
        id="editPostForm">
        <div class="form-group">
            <label for="content">Content</label>
            <textarea id="content" name="content" rows="6" required class="form-textarea"><%= post.content %></textarea>
            <div class="char-counter" id="charCounter">
                <%= post.content.length %> / 1000
            </div>
        </div>

        <div class="form-group">
            <label for="image">Image (optional)</label>
            <div class="custom-file-upload">
                <label for="image" class="file-upload-label">
                    <i class="fas fa-cloud-upload-alt"></i>
                    Choose new image
                </label>
                <input type="file" id="image" name="image" accept="image/*">
                <div id="fileNameDisplay" class="file-name" style="display: none;">
                    <i class="fas fa-check-circle"></i>
                    <span id="selectedFileName"></span>
                    <span class="remove-file" onclick="removeNewFile()">
                        <i class="fas fa-times"></i> Remove
                    </span>
                </div>
            </div>

            <% if (post.imageUrl) { %>
                <div class="current-image" id="currentImageSection">
                    <p>
                        <i class="fas fa-check-circle" style="color: var(--success-color);"></i>
                        Current image:
                    </p>
                    <img src="<%= post.imageUrl %>" alt="Current post image">
                    <label class="checkbox-label">
                        <input type="checkbox" name="removeImage" value="true" id="removeImageCheckbox">
                        <i class="fas fa-trash-alt"></i> Remove current image
                    </label>
                </div>
                <% } %>

                    <div id="imagePreview" class="image-preview" style="display: none;">
                        <p>
                            <i class="fas fa-eye"></i>
                            New image preview:
                        </p>
                        <img src="" alt="Preview">
                        <button type="button" data-remove-image data-input="image">
                            <i class="fas fa-times"></i> Cancel new image
                        </button>
                    </div>
                    <small class="form-text text-muted">Allowed formats: JPEG, PNG, WebP. Max size: 2MB.</small>
        </div>

        <div class="form-actions">
            <a href="/post/<%= post.id %>" class="btn-secondary">
                <i class="fas fa-times"></i> Cancel
            </a>
            <button type="submit" class="btn-primary">
                <i class="fas fa-save"></i> Update Post
            </button>
        </div>
    </form>
</div>

<script>
    (function () {
        const contentTextarea = document.getElementById('content');
        const charCounter = document.getElementById('charCounter');
        const maxChars = 1000;

        function updateCharCount() {
            const length = contentTextarea.value.length;
            charCounter.textContent = `${length} / ${maxChars}`;
            if (length > maxChars) {
                charCounter.classList.add('danger');
            } else if (length > maxChars * 0.9) {
                charCounter.classList.add('warning');
                charCounter.classList.remove('danger');
            } else
                charCounter.classList.remove('warning', 'danger');

        }

        contentTextarea.addEventListener('input', updateCharCount);

        const fileInput = document.getElementById('image');
        const fileNameDisplay = document.getElementById('fileNameDisplay');
        const selectedFileName = document.getElementById('selectedFileName');
        const imagePreview = document.getElementById('imagePreview');
        const currentImageSection = document.getElementById('currentImageSection');
        const removeImageCheckbox = document.getElementById('removeImageCheckbox');
        const removeBtn = document.querySelector('[data-remove-image]');
        const fileLabel = document.querySelector('.file-upload-label');

        function removeNewFile() {
            fileInput.value = '';
            fileNameDisplay.style.display = 'none';
            imagePreview.style.display = 'none';
            if (currentImageSection) {
                currentImageSection.style.opacity = '1';
                currentImageSection.style.pointerEvents = 'auto';
            }
        }

        function handleFileChange(e) {
            const file = e.target.files[0];
            if (file && imagePreview && fileNameDisplay && selectedFileName) {
                selectedFileName.textContent = file.name;
                fileNameDisplay.style.display = 'flex';

                const reader = new FileReader();
                reader.onload = function (event) {
                    const img = imagePreview.querySelector('img');
                    if (img) img.src = event.target.result;
                    imagePreview.style.display = 'block';
                };
                reader.readAsDataURL(file);

                if (fileLabel) fileLabel.classList.add('success');
                setTimeout(() => {
                    if (fileLabel) fileLabel.classList.remove('success');
                }, 300);

                if (removeImageCheckbox) {
                    removeImageCheckbox.checked = false;
                }
                if (currentImageSection) {
                    currentImageSection.style.opacity = '0.5';
                    currentImageSection.style.pointerEvents = 'none';
                }
            }
        }

        function handleCheckboxChange() {
            if (this.checked) {
                if (fileInput && fileInput.value) {
                    removeNewFile();
                }
                if (currentImageSection) {
                    currentImageSection.style.opacity = '0.5';
                }
            } else {
                if (currentImageSection)
                    currentImageSection.style.opacity = '1';
            }
        }

        fileInput.addEventListener('change', handleFileChange);
        if (removeBtn) removeBtn.addEventListener('click', removeNewFile);
        if (removeImageCheckbox) removeImageCheckbox.addEventListener('change', handleCheckboxChange);

        window.removeNewFile = removeNewFile;
    })();
</script>