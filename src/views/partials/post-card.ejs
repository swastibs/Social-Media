<div class="post-card <%= post.imageUrl ? 'has-image' : 'no-image' %>" data-post-id="<%= post.id %>"
    data-post-url="/post/<%= post.id %>" style="cursor: pointer;">
    <div class="post-header">
        <div class="post-author-info">
            <div class="post-author-avatar">
                <% const userProfilePic=post.User?.profilePictureUrl; %>
                    <% if (userProfilePic) { %>
                        <img src="<%= userProfilePic.replace('/upload/', '/upload/w_40,h_40,c_fill,q_auto,f_auto/') %>"
                            alt="<%= post.User.name %>" loading="lazy">
                        <% } else { %>
                            <div class="avatar-initials small" style="width:40px; height:40px;">
                                <%= (post.User && post.User.name) ? post.User.name.substring(0,2).toUpperCase() : 'U' %>
                            </div>
                            <% } %>
            </div>
            <div class="post-author-details">
                <a href="/profile/<%= post.User?.id %>" class="post-author-name">
                    <%= post.User?.name || 'Unknown User' %>
                </a>
                <span class="post-time">
                    <%= new Date(post.createdAt).toLocaleDateString('en-GB') %>
                </span>
            </div>
            <!-- Follow button (only if not hidden AND not the current user) -->
            <% if (!locals.hideFollowButton && locals.currentUser && locals.currentUser.id !==post.User?.id) { %>
                <button class="post-follow-btn <%= post.isFollowing ? 'following' : '' %>"
                    data-user-id="<%= post.User.id %>">
                    <%= post.isFollowing ? 'Unfollow' : 'Follow' %>
                </button>
                <% } %>
                    <!-- Edit/Delete buttons for post owner or admin -->
                    <% if (locals.currentUser && (locals.currentUser.id===post.userId ||
                        locals.currentUser.role==='admin' )) { %>
                        <div class="post-owner-actions">
                            <a href="/post/edit/<%= post.id %>" class="post-edit-btn" title="Edit Post">
                                <i class="fa-regular fa-pen-to-square"></i>
                            </a>
                            <form method="POST" action="/post/delete/<%= post.id %>" style="display: inline;"
                                data-confirm="delete-post">
                                <button type="submit" class="post-delete-btn" title="Delete Post">
                                    <i class="fa-regular fa-trash-can"></i>
                                </button>
                            </form>
                        </div>
                        <% } %>
        </div>
    </div>

    <% if (post.imageUrl) { %>
        <div class="post-image">
            <img src="<%= post.imageUrl %>" alt="Post image" loading="lazy">
        </div>
        <% } %>

            <div class="post-body">
                <p class="post-text">
                    <%= post.content ? post.content.substring(0, 120) : '' %>
                        <%= (post.content && post.content.length> 120) ? '...' : '' %>
                </p>
            </div>

            <div class="post-buttons">
                <button class="post-action like-action <%= post.liked ? 'liked' : '' %>" data-post-id="<%= post.id %>">
                    <i class="fa-regular fa-heart"></i>
                    <span class="like-count-display">
                        <%= post.likeCount || 0 %>
                    </span>
                    <span>
                        <%= post.liked ? 'Unlike' : 'Like' %>
                    </span>
                </button>
                <button class="post-action comment-action" data-post-url="/post/<%= post.id %>">
                    <i class="fa-regular fa-comment"></i>
                    <span class="comment-count-display">
                        <%= post.commentCount || 0 %>
                    </span>
                    <span>Comments</span>
                </button>
            </div>
</div>