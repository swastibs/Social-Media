<aside class="modern-sidebar">
  <div class="sidebar-header">
    <a href="/feed" class="brand"><i class="fa-brands fa-instagram"></i><span>PostLoop</span></a>
  </div>

  <div class="sidebar-profile">
    <a href="/profile/<%= user.id %>" class="profile-link">
      <div class="profile-avatar-side-bar">
        <% if (user.profilePictureUrl) { %>
          <img src="<%= user.profilePictureUrl.replace('/upload/', '/upload/w_128,h_128,c_fill,q_auto,f_auto/') %>"
            alt="<%= user.name %>">
          <% } else { %>
            <div class="avatar-initials" style="width:48px; height:48px; font-size:1.2rem;">
              <%= user.name.substring(0,2).toUpperCase() %>
            </div>
            <% } %>
      </div>
      <div class="profile-info">
        <div class="profile-name">
          <%= user.name %>
        </div>
        <div class="profile-bio">
          <%= user.bio ? user.bio.substring(0,45) : '' %>
        </div>
      </div>
    </a>
  </div>

  <div class="sidebar-stats">
    <a href="/profile/<%= user.id %>" class="stat-item">
      <div class="stat-number">
        <%= user.postsCount || 0 %>
      </div>
      <div class="stat-label">posts</div>
    </a>
    <a href="/profile/<%= user.id %>/followers" class="stat-item">
      <div class="stat-number" id="sidebar-followers-count">
        <%= user.followersCount || 0 %>
      </div>
      <div class="stat-label">followers</div>
    </a>
    <a href="/profile/<%= user.id %>/following" class="stat-item">
      <div class="stat-number" id="sidebar-following-count">
        <%= user.followingCount || 0 %>
      </div>
      <div class="stat-label">following</div>
    </a>
  </div>

  <nav class="sidebar-nav">
    <a href="/feed" class="nav-link"><i class="fa-solid fa-house"></i><span>Feed</span></a>
    <a href="/search" class="nav-link"><i class="fa-solid fa-magnifying-glass"></i><span>Search</span></a>
    <a href="/post/create" class="nav-link"><i class="fa-solid fa-square-plus"></i><span>Create</span></a>
    <a href="/profile/<%= user.id %>" class="nav-link"><i class="fa-solid fa-user"></i><span>Profile</span></a>
  </nav>

  <div class="sidebar-footer">
    <button id="themeToggle" class="theme-toggle-btn"><i id="themeIcon" class="fa-solid fa-moon"></i><span
        id="themeText">Dark Mode</span></button>
    <form method="POST" action="/logout" style="display: inline; width: 100%;">
      <button type="submit" class="logout-btn"
        style="background: none; border: none; width: 100%; text-align: left; cursor: pointer;">
        <i class="fa-solid fa-right-from-bracket"></i> <span>Logout</span>
      </button>
    </form>
  </div>
</aside>

<script>
  window.updateSidebarCounts = function (followingCount, followersCount) {
    const followingSpan = document.getElementById('sidebar-following-count');
    const followersSpan = document.getElementById('sidebar-followers-count');
    if (followingSpan && followingCount !== undefined) followingSpan.innerText = followingCount;
    if (followersSpan && followersCount !== undefined) followersSpan.innerText = followersCount;
  };
</script>