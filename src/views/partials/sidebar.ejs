<aside class="modern-sidebar">
  <div class="sidebar-header">
    <a href="/feed" class="brand"><i class="fa-brands fa-instagram"></i><span>PostLoop</span></a>
  </div>

  <div class="sidebar-profile">
    <a href="/profile/<%= user.id %>" class="profile-link">
      <div class="profile-avatar">
        <% if (user.profilePictureUrl) { %>
          <img src="<%= user.profilePictureUrl.replace('/upload/', '/upload/w_48,h_48,c_fill,q_auto,f_auto/') %>"
            alt="<%= user.name %>">
          <% } else { %>
            <!-- Optimised picsum placeholder: 48x48, WebP, random seed, optional grayscale -->
            <img src="https://picsum.photos/seed/<%= user.id %>/48/48.webp?grayscale&random=<%= user.id %>"
              alt="<%= user.name %>" class="avatar-init-placeholder">
            <% } %>
      </div>
      <div class="profile-info">
        <div class="profile-name">
          <%= user.name %>
        </div>
        <div class="profile-bio">
          <%= user.bio ? user.bio.substring(0,45) : 'No bio yet' %>
        </div>
      </div>
    </a>
  </div>

  <div class="sidebar-stats">
    <div class="stat-item" data-href="/profile/<%= user.id %>?tab=posts">
      <div class="stat-number">
        <%= user.postsCount || 0 %>
      </div>
      <div class="stat-label">posts</div>
    </div>
    <div class="stat-item" data-modal="followers" data-user-id="<%= user.id %>">
      <div class="stat-number">
        <%= user.followersCount || 0 %>
      </div>
      <div class="stat-label">followers</div>
    </div>
    <div class="stat-item" data-modal="following" data-user-id="<%= user.id %>">
      <div class="stat-number">
        <%= user.followingCount || 0 %>
      </div>
      <div class="stat-label">following</div>
    </div>
  </div>

  <nav class="sidebar-nav">
    <a href="/feed" class="nav-link"><i class="fa-solid fa-house"></i><span>Feed</span></a>
    <a href="/search" class="nav-link"><i class="fa-solid fa-magnifying-glass"></i><span>Search</span></a>
    <a href="/post/create" class="nav-link"><i class="fa-solid fa-square-plus"></i><span>Create</span></a>
    <a href="/profile/<%= user.id %>" class="nav-link"><i class="fa-solid fa-user"></i><span>Profile</span></a>
  </nav>

  <div class="sidebar-footer">
    <button id="themeToggle" class="theme-toggle-btn"><i id="themeIcon" class="fa-solid fa-moon"></i><span
        id="themeText">Dark Mode</span></button>
    <a href="/logout" class="logout-btn"><i class="fa-solid fa-right-from-bracket"></i><span>Logout</span></a>
  </div>
</aside>