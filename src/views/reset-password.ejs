<div class="auth-wrapper">
    <div class="auth-box">
        <h2 class="auth-title">Create New Password</h2>

        <form method="POST" action="/reset-password">
            <input type="hidden" name="token" value="<%= token %>">

            <div class="form-group">
                <label for="password">New Password</label>
                <input type="password" id="password" name="password" class="form-input" minlength="4" required>
                <small class="text-muted">Minimum 4 characters</small>
            </div>

            <button type="submit" class="btn-primary" style="width:100%">Reset Password</button>
        </form>

        <div class="auth-link text-center mt-3">
            <a href="/login" class="link-primary">← Back to Login</a>
        </div>
    </div>
</div>