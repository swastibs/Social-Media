<div class="auth-wrapper">
    <div class="auth-box">
        <h2 class="auth-title">Forgot Password</h2>
        <p class="text-center text-muted mb-4">Enter your email address and we'll send you a link to reset your
            password.</p>

        <form method="POST" action="/forgot-password">
            <div class="form-group">
                <label for="email">Email Address</label>
                <input type="email" id="email" name="email" class="form-input" required autofocus>
            </div>
            <button type="submit" class="btn-primary" style="width:100%">Send Reset Link</button>
        </form>

        <div class="auth-link text-center mt-3">
            <a href="/login" class="link-primary">← Back to Login</a>
        </div>
    </div>
</div>