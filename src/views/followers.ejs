<div class="profile-list-container">
    <div class="list-header">
        <h2>
            <%= profileUser.name %>'s Followers
        </h2>
        <a href="/profile/<%= profileUser.id %>" class="back-link">← Back to Profile</a>
    </div>
    <div class="users-grid" id="followersGrid">
        <% if (users.length===0) { %>
            <div class="empty-state">No followers yet.</div>
            <% } else { %>
                <% users.forEach(user=> { %>
                    <div class="user-card" data-user-id="<%= user.id %>" data-href="/profile/<%= user.id %>">
                        <div class="user-card-avatar">
                            <% if (user.thumbnailUrl || user.profilePictureUrl) { %>
                                <img src="<%= user.thumbnailUrl || user.profilePictureUrl %>" alt="<%= user.name %>"
                                    class="img-cover" width="64" height="64" style="width:64px; height:64px;">
                                <% } else { %>
                                    <div class="avatar-initials large">
                                        <%= user.name.substring(0,2).toUpperCase() %>
                                    </div>
                                    <% } %>
                        </div>
                        <div class="user-card-info">
                            <h3 class="user-card-name">
                                <%= user.name %>
                                    <% if (user.isVerified) { %><span class="verified-badge-small"
                                            title="Verified User">✓</span>
                                        <% } %>
                            </h3>
                            <p class="user-card-bio">
                                <%= user.bio ? user.bio.substring(0,80) : '' %>
                            </p>
                            <div class="user-card-stats">
                                <span><i class="fa-regular fa-newspaper"></i>
                                    <%= user.postsCount || 0 %> posts
                                </span>
                                <span><i class="fa-regular fa-user"></i>
                                    <%= user.followersCount || 0 %> followers
                                </span>
                            </div>
                        </div>

                        <% if (currentUser && currentUser.id !==user.id) { %>
                            <button class="list-follow-btn <%= followStatusMap[user.id] ? 'following' : '' %>"
                                data-user-id="<%= user.id %>">
                                <%= followStatusMap[user.id] ? 'Unfollow' : 'Follow' %>
                            </button>
                            <% } %>

                                <% if (currentUser && currentUser.id===profileUser.id) { %>
                                    <button type="button" class="list-follow-btn remove-follower-btn"
                                        data-user-id="<%= user.id %>">
                                        Remove
                                    </button>
                                    <% } %>
                    </div>
                    <% }) %>
                        <% } %>
    </div>

    <% if (pagination.totalPages> 1) { %>
        <div class="pagination-container">
            <ul class="pagination">
                <% if (pagination.hasPrev) { %>
                    <li class="page-item"><a class="page-link" href="?page=<%= pagination.currentPage - 1 %>">&laquo;
                            Previous</a></li>
                    <% } %>
                        <% for (let i=1; i <=pagination.totalPages; i++) { %>
                            <li class="page-item <%= i === pagination.currentPage ? 'active' : '' %>">
                                <a class="page-link" href="?page=<%= i %>">
                                    <%= i %>
                                </a>
                            </li>
                            <% } %>
                                <% if (pagination.hasNext) { %>
                                    <li class="page-item"><a class="page-link"
                                            href="?page=<%= pagination.currentPage + 1 %>">Next &raquo;</a></li>
                                    <% } %>
            </ul>
            <div class="pagination-info">Page <%= pagination.currentPage %> of <%= pagination.totalPages %>
            </div>
        </div>
        <% } %>
</div>

<script>
    (function () {
        function updateFollowerCount(delta) {
            const followersSpan = document.getElementById('sidebar-followers-count');
            if (followersSpan) {
                const newVal = parseInt(followersSpan.innerText) + delta;
                followersSpan.innerText = newVal >= 0 ? newVal : 0;
            }
        }

        const followBtns = document.querySelectorAll('.list-follow-btn:not(.remove-follower-btn)');
        followBtns.forEach(btn => {
            btn.addEventListener('click', async (e) => {
                e.stopPropagation();
                const userId = btn.dataset.userId;
                try {
                    const res = await axios.post(`/follow/${userId}`);
                    if (res.data.following) {
                        btn.textContent = 'Unfollow';
                        btn.classList.add('following');
                        const followingSpan = document.getElementById('sidebar-following-count');
                        if (followingSpan) followingSpan.innerText = parseInt(followingSpan.innerText) + 1;
                    } else {
                        btn.textContent = 'Follow';
                        btn.classList.remove('following');
                        const followingSpan = document.getElementById('sidebar-following-count');
                        if (followingSpan) followingSpan.innerText = parseInt(followingSpan.innerText) - 1;
                    }
                } catch (err) { console.error(err); }
            });
        });

        const removeBtns = document.querySelectorAll('.remove-follower-btn');
        removeBtns.forEach(btn => {
            btn.addEventListener('click', async (e) => {
                e.stopPropagation();
                const followerId = btn.dataset.userId;
                const profileUserId = '<%= profileUser.id %>';
                if (!confirm('Remove this follower? They will no longer see your private posts.')) return;
                try {
                    const res = await axios.post(`/profile/${profileUserId}/followers/remove/${followerId}`);
                    if (res.status === 200 || res.data.success) {
                        const userCard = btn.closest('.user-card');
                        if (userCard) userCard.remove();
                        updateFollowerCount(-1);
                        const grid = document.getElementById('followersGrid');
                        if (grid && grid.querySelectorAll('.user-card').length === 0) {
                            grid.innerHTML = '<div class="empty-state">No followers yet.</div>';
                        }
                    } else {
                        alert('Failed to remove follower');
                    }
                } catch (err) {
                    console.error(err);
                    alert('Something went wrong');
                }
            });
        });

        const userCards = document.querySelectorAll('.user-card');
        userCards.forEach(card => {
            card.addEventListener('click', (e) => {
                if (e.target.tagName !== 'BUTTON') {
                    window.location.href = card.dataset.href;
                }
            });
        });
    })();
</script>