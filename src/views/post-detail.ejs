<div class="post-detail-wrapper">
    <div class="two-column-layout">
        <!-- LEFT COLUMN - Sticky Post -->
        <div class="post-column">
            <div class="post-card-detailed">
                <div class="post-header-detailed">
                    <div class="post-author-info-detailed">
                        <div class="post-author-avatar-detailed">
                            <% if (post.User?.thumbnailUrl || post.User?.profilePictureUrl) { %>
                                <img src="<%= post.User?.thumbnailUrl || post.User?.profilePictureUrl %>"
                                    alt="<%= post.User.name %>" class="img-cover" width="56" height="56"
                                    style="width:56px; height:56px;">
                                <% } else { %>
                                    <div class="avatar-initials">
                                        <%= post.User.name.substring(0,2).toUpperCase() %>
                                    </div>
                                    <% } %>
                        </div>
                        <div class="post-author-details-detailed">
                            <a href="/profile/<%= post.User.id %>" class="post-author-name-detailed">
                                <%= post.User.name %>
                                    <% if (post.User.isVerified) { %>
                                        <span class="verified-badge-small" title="Verified User">✓</span>
                                        <% } %>
                            </a>
                            <div class="post-time-detailed"><i class="fa-regular fa-calendar"></i>
                                <%= new Date(post.createdAt).toLocaleString() %>
                            </div>
                        </div>
                        <% if (currentUser && (currentUser.id===post.userId || currentUser.role==='admin' )) { %>
                            <div class="post-owner-actions-detailed">
                                <a href="/post/edit/<%= post.id %>" class="edit-post-btn-detailed"><i
                                        class="fa-regular fa-pen-to-square"></i> Edit</a>
                                <form method="POST" action="/post/delete/<%= post.id %>" style="display: inline;"
                                    onsubmit="return confirm('Are you sure you want to delete this post?')">
                                    <button type="submit" class="delete-post-btn-detailed"><i
                                            class="fa-regular fa-trash-can"></i> Delete</button>
                                </form>
                            </div>
                            <% } %>
                    </div>
                </div>

                <div class="post-content-detailed">
                    <p class="post-text-detailed">
                        <%= post.content %>
                    </p>
                    <% if (post.imageUrl) { %>
                        <div class="post-image-detailed">
                            <img src="<%= post.imageUrl %>" alt="Post image">
                        </div>
                        <% } %>
                </div>

                <div class="post-stats-detailed">
                    <button class="like-btn-detailed <%= post.liked ? 'liked' : '' %>" data-post-id="<%= post.id %>">
                        <i class="<%= post.liked ? 'fa-solid fa-heart' : 'fa-regular fa-heart' %>"></i>
                        <span class="like-count">
                            <%= post.likeCount %>
                        </span>
                        <span>
                            <%= post.liked ? 'Liked' : 'Like' %>
                        </span>
                    </button>
                    <div class="comment-count-detailed">
                        <i class="fa-regular fa-comment"></i>
                        <span>
                            <%= post.commentCount %> Comments
                        </span>
                    </div>
                </div>
            </div>
        </div>

        <!-- RIGHT COLUMN - Comments Section -->
        <div class="comments-column">
            <div class="comments-card">
                <div class="comments-header">
                    <h3><i class="fa-regular fa-comments"></i> Discussion</h3>
                    <p>Join the conversation</p>
                </div>

                <div class="add-comment-section">
                    <div class="comment-input-wrapper">
                        <textarea id="commentContent" placeholder="Write your comment here..." rows="3"></textarea>
                    </div>
                    <button id="postCommentBtn" class="post-comment-btn" data-post-id="<%= post.id %>">
                        <i class="fa-regular fa-paper-plane"></i> Post Comment
                    </button>
                </div>

                <div id="commentsList" class="comments-list">
                    <% if (comments.length===0) { %>
                        <div class="empty-comments" id="noCommentsMsg">
                            <i class="fa-regular fa-comment-dots"></i>
                            <p>No comments yet. Be the first to comment!</p>
                        </div>
                        <% } else { %>
                            <% comments.forEach(comment=> { %>
                                <div class="comment-item-detailed" id="comment-<%= comment.id %>">
                                    <div class="comment-avatar-detailed">
                                        <% if (comment.User?.thumbnailUrl || comment.User?.profilePictureUrl) { %>
                                            <img src="<%= comment.User?.thumbnailUrl || comment.User?.profilePictureUrl %>"
                                                alt="<%= comment.User.name %>" class="img-cover" width="44" height="44"
                                                style="width:44px; height:44px;">
                                            <% } else { %>
                                                <div class="avatar-initials">
                                                    <%= comment.User.name.substring(0,2).toUpperCase() %>
                                                </div>
                                                <% } %>
                                    </div>
                                    <div class="comment-content-detailed">
                                        <div class="comment-author-detailed">
                                            <a href="/profile/<%= comment.User.id %>"
                                                class="comment-author-name-detailed">
                                                <%= comment.User.name %>
                                                    <% if (comment.User.isVerified) { %>
                                                        <span class="verified-badge-small"
                                                            title="Verified User">✓</span>
                                                        <% } %>
                                            </a>
                                            <span class="comment-time-detailed"><i class="fa-regular fa-clock"></i>
                                                <%= new Date(comment.createdAt).toLocaleString() %>
                                            </span>
                                        </div>
                                        <p class="comment-text-detailed" id="comment-text-<%= comment.id %>">
                                            <%= comment.content %>
                                        </p>
                                        <% if (currentUser && (currentUser.id===comment.userId ||
                                            currentUser.id===post.userId || currentUser.role==='admin' )) { %>
                                            <div class="comment-actions-detailed">
                                                <% if (currentUser.id===comment.userId) { %>
                                                    <button class="edit-comment-btn-detailed"
                                                        data-comment-id="<%= comment.id %>"
                                                        data-post-id="<%= post.id %>">
                                                        <i class="fa-regular fa-pen-to-square"></i> Edit
                                                    </button>
                                                    <% } %>
                                                        <button class="delete-comment-btn-detailed"
                                                            data-comment-id="<%= comment.id %>"
                                                            data-post-id="<%= post.id %>">
                                                            <i class="fa-regular fa-trash-can"></i> Delete
                                                        </button>
                                            </div>
                                            <% } %>
                                    </div>
                                </div>
                                <% }) %>
                                    <% } %>
                </div>

                <% if (pagination.totalPages> 1) { %>
                    <div class="pagination-wrapper">
                        <div class="pagination-comments-detailed">
                            <% for (let i=1; i <=pagination.totalPages; i++) { %>
                                <a href="?page=<%= i %>"
                                    class="page-link-detailed <%= i === pagination.currentPage ? 'active' : '' %>">
                                    <%= i %>
                                </a>
                                <% } %>
                        </div>
                    </div>
                    <% } %>
            </div>
        </div>
    </div>
</div>

<script>
    // Like button functionality
    const likeBtn = document.querySelector('.like-btn-detailed');
    if (likeBtn) {
        likeBtn.addEventListener('click', async function () {
            const postId = this.dataset.postId;
            try {
                const res = await axios.post(`/post/${postId}/like`);
                const likeCountSpan = this.querySelector('.like-count');
                likeCountSpan.innerText = res.data.likeCount;

                if (res.data.liked) {
                    this.classList.add('liked');
                    this.innerHTML = `<i class="fa-solid fa-heart"></i> <span class="like-count">${res.data.likeCount}</span> <span>Liked</span>`;
                } else {
                    this.classList.remove('liked');
                    this.innerHTML = `<i class="fa-regular fa-heart"></i> <span class="like-count">${res.data.likeCount}</span> <span>Like</span>`;
                }
            } catch (err) {
                console.error(err);
            }
        });
    }

    // Create comment functionality
    const postCommentBtn = document.getElementById('postCommentBtn');
    if (postCommentBtn) {
        postCommentBtn.addEventListener('click', async function () {
            const postId = this.dataset.postId;
            const content = document.getElementById('commentContent').value.trim();

            if (!content) {
                alert('Please write a comment');
                return;
            }

            try {
                const res = await axios.post('/comment/create', { postId, content });
                if (res.data.success) {
                    const newComment = res.data.comment;
                    const noCommentsMsg = document.getElementById('noCommentsMsg');
                    if (noCommentsMsg) noCommentsMsg.remove();

                    const commentHtml = `
                        <div class="comment-item-detailed" id="comment-${newComment.id}">
                            <div class="comment-avatar-detailed">
                                ${newComment.User.profilePictureUrl
                            ? `<img src="${newComment.User.thumbnailUrl || newComment.User.profilePictureUrl}" alt="${escapeHtml(newComment.User.name)}" class="img-cover" width="44" height="44" style="width:44px; height:44px;">`
                            : `<div class="avatar-initials" style="width: 100%; height: 100%; font-size: 0.9rem;">${escapeHtml(newComment.User.name.substring(0, 2).toUpperCase())}</div>`}
                            </div>
                            <div class="comment-content-detailed">
                                <div class="comment-author-detailed">
                                    <a href="/profile/${newComment.User.id}" class="comment-author-name-detailed">${escapeHtml(newComment.User.name)}</a>
                                    <span class="comment-time-detailed"><i class="fa-regular fa-clock"></i> Just now</span>
                                </div>
                                <p class="comment-text-detailed">${escapeHtml(newComment.content)}</p>
                                <div class="comment-actions-detailed">
                                    <button class="edit-comment-btn-detailed" data-comment-id="${newComment.id}" data-post-id="${postId}">
                                        <i class="fa-regular fa-pen-to-square"></i> Edit
                                    </button>
                                    <button class="delete-comment-btn-detailed" data-comment-id="${newComment.id}" data-post-id="${postId}">
                                        <i class="fa-regular fa-trash-can"></i> Delete
                                    </button>
                                </div>
                            </div>
                        </div>`;

                    const commentsList = document.getElementById('commentsList');
                    commentsList.insertAdjacentHTML('afterbegin', commentHtml);
                    document.getElementById('commentContent').value = '';
                    attachCommentEvents();
                    updateCommentCount(res.data.commentCount);
                }
            } catch (err) {
                console.error(err);
                alert(err.response?.data?.message || 'Failed to post comment');
            }
        });
    }

    // Delete comment function
    async function deleteComment(commentId) {
        if (!confirm('Are you sure you want to delete this comment?')) return;

        try {
            const res = await axios.delete(`/comment/${commentId}`);
            if (res.data.success) {
                const commentElem = document.getElementById(`comment-${commentId}`);
                if (commentElem) commentElem.remove();
                updateCommentCount(res.data.commentCount);

                const commentsList = document.getElementById('commentsList');
                if (!commentsList.querySelector('.comment-item-detailed')) {
                    commentsList.innerHTML = '<div class="empty-comments" id="noCommentsMsg"><i class="fa-regular fa-comment-dots"></i><p>No comments yet. Be the first to comment!</p></div>';
                }
            }
        } catch (err) {
            alert(err.response?.data?.message || 'Failed to delete comment');
        }
    }

    // Edit comment function
    async function editComment(commentId) {
        const commentDiv = document.getElementById(`comment-${commentId}`);
        if (!commentDiv) return;

        const textP = commentDiv.querySelector('.comment-text-detailed');
        const actionsDiv = commentDiv.querySelector('.comment-actions-detailed');
        const currentText = textP.innerText;

        textP.style.display = 'none';
        if (actionsDiv) actionsDiv.style.display = 'none';

        const textarea = document.createElement('textarea');
        textarea.value = currentText;
        textarea.classList.add('edit-textarea-detailed');

        const saveBtn = document.createElement('button');
        saveBtn.innerHTML = '<i class="fa-regular fa-floppy-disk"></i> Save';
        saveBtn.classList.add('post-comment-btn');
        saveBtn.style.marginRight = '0.5rem';

        const cancelBtn = document.createElement('button');
        cancelBtn.innerHTML = '<i class="fa-regular fa-circle-xmark"></i> Cancel';
        cancelBtn.classList.add('edit-comment-btn-detailed');
        cancelBtn.style.background = 'var(--bg-secondary)';
        cancelBtn.style.color = 'var(--text-color)';

        const commentContentDiv = commentDiv.querySelector('.comment-content-detailed');
        commentContentDiv.appendChild(textarea);
        commentContentDiv.appendChild(saveBtn);
        commentContentDiv.appendChild(cancelBtn);

        saveBtn.onclick = async () => {
            const newContent = textarea.value.trim();
            if (!newContent) return;

            try {
                const res = await axios.put(`/comment/${commentId}`, { content: newContent });
                if (res.data.success) {
                    textP.innerText = newContent;
                    textP.style.display = 'block';
                    if (actionsDiv) actionsDiv.style.display = 'flex';
                    textarea.remove();
                    saveBtn.remove();
                    cancelBtn.remove();
                } else {
                    alert(res.data.message || 'Edit failed');
                }
            } catch (err) {
                alert(err.response?.data?.message || 'Edit failed');
            }
        };

        cancelBtn.onclick = () => {
            textP.style.display = 'block';
            if (actionsDiv) actionsDiv.style.display = 'flex';
            textarea.remove();
            saveBtn.remove();
            cancelBtn.remove();
        };
    }

    // Attach event listeners to comment buttons
    function attachCommentEvents() {
        document.querySelectorAll('.delete-comment-btn-detailed').forEach(btn => {
            btn.removeEventListener('click', btn._handler);
            btn._handler = () => deleteComment(btn.dataset.commentId);
            btn.addEventListener('click', btn._handler);
        });

        document.querySelectorAll('.edit-comment-btn-detailed').forEach(btn => {
            btn.removeEventListener('click', btn._handler);
            btn._handler = () => editComment(btn.dataset.commentId);
            btn.addEventListener('click', btn._handler);
        });
    }

    function updateCommentCount(newCount) {
        const commentCountSpan = document.querySelector('.comment-count-detailed span');
        if (commentCountSpan) commentCountSpan.innerText = `${newCount} Comments`;
    }

    function escapeHtml(str) {
        if (!str) return '';
        return str.replace(/[&<>]/g, function (m) {
            if (m === '&') return '&amp;';
            if (m === '<') return '&lt;';
            if (m === '>') return '&gt;';
            return m;
        });
    }

    // Initialize event listeners
    attachCommentEvents();

    (function () {
        let likeBtn = null;
        let postCommentBtn = null;
        let deleteHandlers = [];
        let editHandlers = [];

        function finalCleanup() {
            if (likeBtn) {
                likeBtn.removeEventListener('click', likeBtn._listener);
                likeBtn = null;
            }
            if (postCommentBtn) {
                postCommentBtn.removeEventListener('click', postCommentBtn._listener);
                postCommentBtn = null;
            }
            deleteHandlers.forEach(({ btn, handler }) => {
                if (btn) btn.removeEventListener('click', handler);
            });
            editHandlers.forEach(({ btn, handler }) => {
                if (btn) btn.removeEventListener('click', handler);
            });
            deleteHandlers = [];
            editHandlers = [];
        }

        window.cleanupPostDetail = finalCleanup;
    })();
</script>