<div class="post-detail-container">
    <div class="post-card">
        <div class="post-header">
            <div class="post-author-info">
                <div class="post-author-avatar">
                    <% if (post.User.profilePictureUrl) { %>
                        <img src="<%= post.User.profilePictureUrl.replace('/upload/', '/upload/w_40,h_40,c_fill,q_auto,f_auto/') %>"
                            alt="<%= post.User.name %>">
                        <% } else { %>
                            <div class="avatar-initials small">
                                <%= post.User.name.substring(0,2).toUpperCase() %>
                            </div>
                            <% } %>
                </div>
                <div class="post-author-details">
                    <a href="/profile/<%= post.User.id %>" class="post-author-name">
                        <%= post.User.name %>
                    </a>
                    <span class="post-time">
                        <%= new Date(post.createdAt).toLocaleString() %>
                    </span>
                </div>
                <% if (currentUser && (currentUser.id===post.userId || currentUser.role==='admin' )) { %>
                    <div class="post-owner-actions">
                        <a href="/post/edit/<%= post.id %>" class="edit-post-btn btn-secondary"
                            style="padding: 0.2rem 0.6rem;">Edit</a>
                        <form method="POST" action="/post/delete/<%= post.id %>" style="display: inline;"
                            data-confirm="delete-post">
                            <button type="submit" class="delete-post-btn btn-danger"
                                style="padding: 0.2rem 0.6rem;">Delete</button>
                        </form>
                    </div>
                    <% } %>
            </div>
        </div>
        <div class="post-content-full">
            <p class="post-text-full">
                <%= post.content %>
            </p>
            <% if (post.imageUrl) { %>
                <div class="post-image-full">
                    <img src="<%= post.imageUrl %>" alt="Post image" style="max-width: 100%;">
                </div>
                <% } %>
        </div>
        <div class="post-actions-footer">
            <button class="like-btn <%= post.liked ? 'liked' : '' %>" data-post-id="<%= post.id %>">
                <i class="fa-regular fa-heart"></i> <span class="like-count">
                    <%= post.likeCount %>
                </span>
            </button>
            <span class="comment-count"><i class="fa-regular fa-comment"></i>
                <%= post.commentCount %> comments
            </span>
        </div>
    </div>

    <div class="comments-section">
        <h3>Comments</h3>
        <div class="add-comment">
            <textarea id="commentContent" placeholder="Write a comment..." rows="2" class="form-input"></textarea>
            <button id="postCommentBtn" class="btn-primary" data-post-id="<%= post.id %>">Post Comment</button>
        </div>

        <div id="commentsList">
            <% if (comments.length===0) { %>
                <p class="text-muted">No comments yet. Be the first!</p>
                <% } else { %>
                    <% comments.forEach(comment=> { %>
                        <div class="comment-item" id="comment-<%= comment.id %>">
                            <div class="comment-avatar">
                                <% if (comment.User.profilePictureUrl) { %>
                                    <img src="<%= comment.User.profilePictureUrl.replace('/upload/', '/upload/w_32,h_32,c_fill,q_auto,f_auto/') %>"
                                        alt="<%= comment.User.name %>">
                                    <% } else { %>
                                        <div class="avatar-initials tiny">
                                            <%= comment.User.name.substring(0,2).toUpperCase() %>
                                        </div>
                                        <% } %>
                            </div>
                            <div class="comment-content">
                                <div class="comment-author">
                                    <a href="/profile/<%= comment.User.id %>">
                                        <%= comment.User.name %>
                                    </a>
                                    <span class="comment-time">
                                        <%= new Date(comment.createdAt).toLocaleString() %>
                                    </span>
                                </div>
                                <p class="comment-text">
                                    <%= comment.content %>
                                </p>
                                <% if (currentUser && (currentUser.id===comment.userId || currentUser.id===post.userId
                                    || currentUser.role==='admin' )) { %>
                                    <div class="comment-actions">
                                        <button class="delete-comment-btn" data-comment-id="<%= comment.id %>"
                                            data-post-id="<%= post.id %>">Delete</button>
                                    </div>
                                    <% } %>
                            </div>
                        </div>
                        <% }) %>
                            <% } %>
        </div>

        <!-- Pagination for comments -->
        <% if (pagination.totalPages> 1) { %>
            <div class="pagination-comments">
                <% for (let i=1; i <=pagination.totalPages; i++) { %>
                    <a href="?page=<%= i %>" class="page-link <%= i === pagination.currentPage ? 'active' : '' %>">
                        <%= i %>
                    </a>
                    <% } %>
            </div>
            <% } %>
    </div>
</div>

<script>
    // Like button AJAX
    document.querySelector('.like-btn').addEventListener('click', async function () {
        const postId = this.dataset.postId;
        try {
            const res = await axios.post(`/post/${postId}/like`);
            this.querySelector('.like-count').innerText = res.data.likeCount;
            if (res.data.liked) {
                this.classList.add('liked');
            } else {
                this.classList.remove('liked');
            }
        } catch (err) { console.error(err); }
    });

    // Post comment AJAX
    document.getElementById('postCommentBtn').addEventListener('click', async function () {
        const postId = this.dataset.postId;
        const content = document.getElementById('commentContent').value.trim();
        if (!content) return;
        try {
            const res = await axios.post(`/api/comments`, { postId, content });
            if (res.data.success) {
                location.reload(); // simple reload – could dynamically append
            }
        } catch (err) { console.error(err); }
    });

    // Delete comment AJAX (optional, but we'll use POST form)
    document.querySelectorAll('.delete-comment-btn').forEach(btn => {
        btn.addEventListener('click', async function () {
            if (!confirm('Delete this comment?')) return;
            const commentId = this.dataset.commentId;
            const postId = this.dataset.postId;
            try {
                await axios.delete(`/api/comments/${commentId}`);
                document.getElementById(`comment-${commentId}`).remove();
            } catch (err) { console.error(err); }
        });
    });
</script>