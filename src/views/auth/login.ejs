<div class="row justify-content-center mt-5">
    <div class="col-md-6">
        <h2>Login</h2>
        <form method="POST" action="/login">
            <div class="mb-3">
                <label>Email</label>
                <input type="email" name="email" class="form-control" value="<%= oldInput.email || '' %>" required>
            </div>
            <div class="mb-3">
                <label>Password</label>
                <input type="password" name="password" class="form-control" required>
            </div>
            <button type="submit" class="btn btn-primary">Login</button>
        </form>
        <p class="mt-3">No account? <a href="/signup">Sign up</a></p>
    </div>
</div>

<script>
    if (document.cookie.split('; ').find(row => row.startsWith('token='))) window.location.href = '/feed';
</script>