<div class="auth-wrapper">
    <div class="auth-box">
        <h2 class="auth-title">Change Password</h2>

        <form method="POST" action="/change-password" class="auth-form">
            <div class="form-group">
                <label>Current Password</label>
                <input type="password" name="oldPassword" class="form-input" value="<%= oldInput.oldPassword || '' %>"
                    required>
            </div>

            <div class="form-group">
                <label>New Password</label>
                <input type="password" name="newPassword" class="form-input" required>
                <small>Minimum 4 characters</small>
            </div>

            <div class="form-group">
                <label>Confirm New Password</label>
                <input type="password" name="confirmPassword" class="form-input" required>
            </div>

            <button type="submit" class="btn-primary auth-submit">Change Password</button>
        </form>

        <div class="auth-link">
            <a href="/profile/<%= user ? user.id : '' %>" class="link-primary">← Back to Profile</a>
        </div>
    </div>
</div>